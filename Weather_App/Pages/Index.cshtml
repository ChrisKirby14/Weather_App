    <!-- JavaScript to handle the animation loop -->
<script>
    const tempFrames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapImages?.TemperatureMapUrls ?? new List<string>()));

    let currentFrameIndex = 0;

    // 2. This function loops through the images
    function renderNextFrame() {
        if (tempFrames && tempFrames.length > 0) {
            // Calculate the real future time based on the current frame index
            const frameTime = new Date();
            frameTime.setHours(frameTime.getHours() + currentFrameIndex);

            // --- THIS LINE WAS MISSING ---
            const timeString = frameTime.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
            // -----------------------------

            // Display the image and update the time text
            document.getElementById('animated-map').src = tempFrames[currentFrameIndex];
            document.getElementById('animated-map').style.display = 'inline';
            document.getElementById('frame-counter').innerText = `Forecast Time: ${timeString}`;

            // Move to the next frame. If we hit the end (12), loop back to 0.
            currentFrameIndex = (currentFrameIndex + 1) % tempFrames.length;
        } else {
            // Fallback if the API returns empty data
            document.getElementById('animated-map').style.display = 'none';
            document.getElementById('frame-counter').innerText = "Map data currently unavailable.";
        }
    }

    renderNextFrame();
